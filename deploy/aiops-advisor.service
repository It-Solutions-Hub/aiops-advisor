# systemd unit for the Lab 2 AIOps Advisor.
# Installed by setup-lab2.sh as /etc/systemd/system/aiops-advisor.service.
#
#   install -m 0755 -d /opt/aiops-advisor/fixtures /var/log/aiops-advisor
#   install -m 0644 service/advisor_service.py      /opt/aiops-advisor/
#   install -m 0644 service/fixtures/*.json         /opt/aiops-advisor/fixtures/
#   install -m 0755 cli/aiops-advisor              /usr/local/bin/aiops-advisor
#   useradd --system --no-create-home --shell /usr/sbin/nologin aiops
#   chown -R aiops:aiops /var/log/aiops-advisor
#   systemctl daemon-reload && systemctl enable --now aiops-advisor

[Unit]
Description=AIOps Advisor (Lab 2 mock recommendation service)
Documentation=file:/opt/aiops-advisor/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aiops
Group=aiops
Environment=AIOPS_ADVISOR_ADDR=0.0.0.0
Environment=AIOPS_ADVISOR_PORT=8600
Environment=AIOPS_ADVISOR_FIXTURES=/opt/aiops-advisor/fixtures
Environment=AIOPS_ADVISOR_LOG=/var/log/aiops-advisor/requests.jsonl
ExecStart=/usr/bin/python3 /opt/aiops-advisor/advisor_service.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/aiops-advisor
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
